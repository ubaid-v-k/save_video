# MediaBox Environment Configuration
MEDIABOX_APP_NAME="MediaBox"
MEDIABOX_APP_VERSION="1.0.0"
MEDIABOX_MAX_UPLOAD_SIZE_MB=2000
MEDIABOX_MAX_CONCURRENT_JOBS=2
MEDIABOX_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Optional custom paths if not using system PATH or WinGet:
# MEDIABOX_CUSTOM_FFMPEG_PATH="C:\\path\\to\\ffmpeg.exe"
# MEDIABOX_CUSTOM_FFPROBE_PATH="C:\\path\\to\\ffprobe.exe"
